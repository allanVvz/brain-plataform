# n8n (optional; leave empty for offline/local operation)
N8N_BASE_URL=
N8N_API_KEY=

# AI
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# Workers
WORKER_INTERVAL=900
N8N_MIRROR_INTERVAL=300
HEALTH_CHECK_INTERVAL=120
KB_SYNC_INTERVAL=3600

# Dashboard
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_ANON_KEY}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SUPABASE_ANON_KEY}

# Vault source
# local keeps reading OBSIDIAN_LOCAL_PATH/VAULT_PATH.
# github reads the vault through GitHub API and does not require a local repo.
VAULT_SOURCE_MODE=local
OBSIDIAN_LOCAL_PATH=C:\Ai-Brain\Ai-Brain
GITHUB_VAULT_REPO=
GITHUB_VAULT_BRANCH=
GITHUB_VAULT_ROOT=
GITHUB_TOKEN=
