# AI Brain local runtime
#
# The operational environment file is `.env.compose`.
# Generate it with:
#
#   python infra/generate_keys.py --write .env.compose
#
# Then run:
#
#   docker compose --env-file .env.compose up -d --build
#
# Dashboard local env lives in `dashboard/.env.local`.
API_INTERNAL_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=/api-brain

# Optional integrations
N8N_BASE_URL=
N8N_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
