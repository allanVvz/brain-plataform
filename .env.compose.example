# .env.compose â€” local Docker stack config for audit/repro.
# Copy to .env.compose (gitignored) and fill in. Generate the JWT block with:
#   python infra/generate_keys.py --write .env.compose

# â”€â”€ Postgres â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Used by db, and as the password for the authenticator / storage_admin roles.
POSTGRES_PASSWORD=change-me-strong-password
DB_PORT=5432

# â”€â”€ JWT material (generate_keys.py writes these three) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# JWT_SECRET signs/validates every PostgREST + Storage request (HS256, >=32 chars).
# SERVICE_ROLE_KEY is the JWT the API uses as SUPABASE_SERVICE_KEY (role=service_role).
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# â”€â”€ Supabase URL seen by the API/workers (and, for assets, by browsers) â”€
# Internal default lets the stack work end-to-end on one host.
# IMPORTANT: signed asset URLs are emitted as ${SUPABASE_URL}/storage/v1/...
# so for the external cardapio/dashboard to render images, set this to the
# PUBLIC https domain of Kong (TLS via a Caddy/Traefik reverse proxy).
SUPABASE_URL=http://kong:8000
KONG_PORT=8000

# â”€â”€ Backend â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
API_PORT=8080
ENVIRONMENT=qa
OPENAI_API_KEY=
# Optional: enables Claude-based graph validation in Sofia (falls back to OpenAI).
ANTHROPIC_API_KEY=
# Obsidian vault path INSIDE the container for the Sofia/kb-intake save pipeline.
# Defaults to /data/vault (a writable named volume); override only if needed.
VAULT_PATH=/data/vault
# Canonical Sofia (Janela 2): tool-driven planning + canonical graph validator
# (allows audience->product_group->product; no per-audience product cloning).
# Default true in the compose; set false to fall back to the legacy planner.
SOFIA_TOOLS_ENABLED=true
# CORS: include the dashboard + cardapio public origins (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://baita-cardapio.vercel.app
# Optional regex for Vercel preview subdomains.
ALLOWED_ORIGIN_REGEX=

# â”€â”€ Storage â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
FILE_SIZE_LIMIT=52428800

# â”€â”€ Migrations / seed (migrate one-shot) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# APPLY_SEED=1 + SEED_FILE to load a minimal catalog after migrations.
APPLY_SEED=0
SEED_FILE=

# â”€â”€ Optional Supabase Studio (compose --profile studio) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
STUDIO_PORT=3030
