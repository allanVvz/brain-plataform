# Copy only to .env.compose on the target host. Never commit the populated file.
# Generate JWT_SECRET/ANON_KEY/SERVICE_ROLE_KEY together with:
#   python3 infra/generate_keys.py --write .env.compose

COMPOSE_PROJECT_NAME=brain-ai
ENVIRONMENT=qa
IMAGE_TAG=local
API_IMAGE=brain-api
MIGRATE_IMAGE=brain-migrate

POSTGRES_DB=brain
POSTGRES_USER=postgres
# Use URL-safe random values because this secret is also used in connection URIs.
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
AI_BRAIN_AUTH_SECRET=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
AI_BRAIN_WEBHOOK_TOKEN=REPLACE_WITH_URL_SAFE_RANDOM_VALUE
N8N_ENCRYPTION_KEY=REPLACE_WITH_URL_SAFE_RANDOM_VALUE

API_DOMAIN=api.localhost
STORAGE_DOMAIN=storage.localhost
N8N_DOMAIN=localhost
ACME_EMAIL=ops@example.invalid
SUPABASE_PUBLIC_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
# Anchor previews to an explicitly approved Vercel project; leave blank to disable.
ALLOWED_ORIGIN_REGEX=
AI_BRAIN_COOKIE_SECURE=false

API_PORT=8080
API_INTERNAL_BASE_URL=http://api:8080
N8N_PROTOCOL=http
N8N_PORT=5678
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_OUTBOUND_WEBHOOK_URL=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_ALLOW_UNSIGNED_LOCAL=false
META_WHATSAPP_ACCESS_TOKEN=
WHATSAPP_META_PERSONA_SLUG=
WHATSAPP_EVOLUTION_PERSONA_SLUG=
META_GRAPH_API_VERSION=v23.0
EVOLUTION_ENABLED=false
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_VERSION=2.3.7
# Validated Evolution 2.3.7 multi-platform manifest digest.
EVOLUTION_API_IMAGE=evoapicloud/evolution-api@sha256:1bd8afc4a6cf48822e6cf02469aeae7bd35a12a6b616eacd1291926307f4d339
EVOLUTION_AUTHENTICATION_API_KEY=
EVOLUTION_DB_PASSWORD=
EVOLUTION_REDIS_PASSWORD=
EVOLUTION_WEBHOOK_HMAC_SECRET=
AI_BRAIN_SECRETS_KEY=
AI_BRAIN_PUBLIC_API_URL=
WA_VALIDATOR_RUNNER_URL=http://wa-validator:3010
FILE_SIZE_LIMIT=52428800
SOFIA_TOOLS_ENABLED=true
APPLY_LEGACY_BOOTSTRAP=1

# Optional first-boot admin. Remove the password from .env.compose after success.
AI_BRAIN_SEED_ADMIN_EMAIL=
AI_BRAIN_SEED_ADMIN_USERNAME=admin
AI_BRAIN_SEED_ADMIN_PASSWORD=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional local-only workaround for networks that intercept PyPI TLS.
# Leave blank in normal environments. Example:
# PIP_TRUSTED_HOST=pypi.org files.pythonhosted.org
PIP_TRUSTED_HOST=

# QA-only: makes campaign eligibility treat an existing Meta binding as ready.
# It never sends traffic; Sofia's rollout stops at campaign draft creation.
AI_BRAIN_META_MOCK=false
