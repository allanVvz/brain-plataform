# Production self-hosted defaults.
# Copy to .env.prod and run:
# docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

POSTGRES_DB=brain
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=54322

API_PORT=8000
DASHBOARD_PORT=3000
SUPABASE_GATEWAY_PORT=54321

# URLs resolved inside the Docker network.
API_INTERNAL_URL=http://api:8000

# URLs resolved by the browser/operator machine.
PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Supabase-compatible JWTs.
# Regenerate these together with LOCAL_SUPABASE_JWT_SECRET before real production use.
LOCAL_SUPABASE_JWT_SECRET=local-dev-jwt-secret-at-least-32-chars-change-me
LOCAL_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJhaS1icmFpbi1sb2NhbCIsInJlZiI6ImxvY2FsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjAwMDAwMDAsImV4cCI6NDEwMjQ0NDgwMH0.Rkedc_mLxgOvplPbhwZvT0xCDBYnFm1hnWbcjRW8oxE
LOCAL_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJhaS1icmFpbi1sb2NhbCIsInJlZiI6ImxvY2FsIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2MDAwMDAwMCwiZXhwIjo0MTAyNDQ0ODAwfQ.v0SAbD0EDzJ4V1r_7c2O0-elmx5EoIAB50ky3ShmrNw

AI_BRAIN_AUTH_SECRET=change-me-auth-secret
VAULT_SOURCE_MODE=local
RUN_EMBEDDED_WORKERS=false

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
