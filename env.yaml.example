# env.yaml.example
# Copy to env.yaml (gitignored) and fill in real values.
# Cloud Run consumes this via:
#   gcloud run deploy ai-brain-api --source ./api --region us-central1 --env-vars-file env.yaml
SUPABASE_URL: "https://<project-ref>.supabase.co"
SUPABASE_SERVICE_KEY: "<service-role-key>"
OPENAI_API_KEY: "<openai-api-key>"
ENVIRONMENT: "production"
# Comma-separated list of origins allowed by CORS.
# Production must include the public cardapio and the dashboard.
ALLOWED_ORIGINS: "http://localhost:3000,http://localhost:3001,http://localhost:5173,https://brain-plataform.vercel.app,https://baita-cardapio.vercel.app"
# Optional: a regex that ALSO permits an origin. Use for Vercel preview deployments
# with team-scoped subdomains (eg. https://<project>-<branch>-<team>.vercel.app).
# ALLOWED_ORIGIN_REGEX: "https://baita-cardapio(-[a-z0-9-]+)?-allanvvzs-projects\\.vercel\\.app"
# QA-only: shared admin token used by Codex / Claude to call write endpoints
# (bind-slot, ensure-gallery, edge deletion). The auth middleware accepts this
# only when ENVIRONMENT in {qa,preview}; production never accepts the header.
# AI_BRAIN_ADMIN_TEST_TOKEN: "<generate with: python -c \"import secrets;print(secrets.token_hex(32))\">"
