{
	email {$ACME_EMAIL}
	admin off
}

{$API_DOMAIN} {
	encode zstd gzip
	# Access metadata only (method, path, status and latency); request bodies are not logged.
	log {
		output stdout
		format json
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	handle /webhooks/whatsapp* {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy api:8080
	}
}

{$STORAGE_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	handle /storage/v1/* {
		reverse_proxy kong:8000
	}
	respond 404
}

{$N8N_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
	reverse_proxy n8n:5678
}

