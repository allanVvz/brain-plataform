# --- Backend (preferido: proxy same-origin /api-brain). Ver dashboard/BACKEND_CONFIG.md ---
# O browser chama /api-brain/* (relativo); o next.config.js reescreve server-side
# para API_INTERNAL_BASE_URL. API_INTERNAL_BASE_URL NUNCA vai para o browser.
#   Local (Docker):   http://localhost:8080
#   Vercel via tunel: https://<cloudflared|ngrok>
#   Producao real:    https://api.seudominio.com
API_INTERNAL_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=/api-brain
# --- Legado (fallback do rewrite, ainda suportado) ---
# NEXT_PUBLIC_API_URL=https://SEU-BACKEND-CLOUD-RUN.run.app
# NEXT_PUBLIC_AI_BRAIN_URL=https://SEU-BACKEND-CLOUD-RUN.run.app
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SEU_SUPABASE_ANON_KEY
# opcional fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_SUPABASE_ANON_KEY
# Base do catalogo publico exibido na tela /persona. O slug da persona e
# anexado em runtime, ex: ${NEXT_PUBLIC_CARDAPIO_BASE_URL}/vzlupas.
# PROD: https://baita-cardapio.vercel.app
# QA:   https://baita-cardapio-qa.vercel.app
NEXT_PUBLIC_CARDAPIO_BASE_URL=https://baita-cardapio.vercel.app
